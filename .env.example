# Supabase (Project Settings -> API)
# La URL es la misma en ambas variables: la versión NEXT_PUBLIC_ la necesitan
# el navegador (login/signup) y el middleware; la otra la usan las rutas
# de servidor puro como /tap y /api/stands/pair.
SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...              # pública, para el navegador
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # secreta, SOLO server-side, nunca en el cliente

# Upstash Redis (opcional pero recomendado para escala)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# A dónde mandar a alguien si el código no existe o el negocio está inactivo
FALLBACK_URL=https://tudominio.com/menu-no-disponible

# Base de la pantalla de aprovisionamiento para stands sin emparejar
ONBOARDING_BASE_URL=https://tudominio.com/onboarding

# Usado por el link de "olvidé mi contraseña" para volver a tu dominio real
NEXT_PUBLIC_SITE_URL=https://tudominio.com
